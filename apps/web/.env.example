# Copy to .env.local (gitignored) for local dev. Values below match a fresh
# `supabase start` local instance. Real staging/production values belong in
# the hosting platform's env var store, not a committed file.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Admin seeding tool (/admin) only — service role bypasses RLS, never expose
# to the client. Value below matches a fresh local `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Password gate for /admin (a shared secret, not per-user Supabase auth —
# deliberately simple per the brief's "can be simple" framing for this
# internal-only tool). Set a real value in .env.local; this default is only
# for local dev.
ADMIN_PASSWORD=pobo-admin-dev

# Custom URL scheme the mobile app registers (see apps/mobile/app.json).
# Used for the "Open in app" button — real Universal Links (auto-open,
# no scheme needed) require a domain + Apple Team ID we don't have yet.
NEXT_PUBLIC_APP_SCHEME=pobo
