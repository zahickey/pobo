# Copy to .env (gitignored) for local dev. Values below match a fresh
# `supabase start` local instance (see repo root README / supabase/config.toml).
# These local anon/demo keys are the same for every Supabase project run
# locally — they are not secrets. Real staging/production values go in
# EAS's environment variable store, not in a committed file.

# 127.0.0.1 only works for the iOS Simulator (shares the Mac's network).
# Testing on a physical device needs the Mac's actual LAN IP instead — run
# `ipconfig getifaddr en0` and use that, e.g. http://192.168.1.71:54321.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Google Sign-In — client IDs are public identifiers, safe to commit (unlike
# the client *secret*, which lives only in supabase/.env.local, server-side).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=982339084703-8hf0l6oms9e3dthgo8cbe95j24r9gdee.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=982339084703-g6qu2gnb23n9bhq0ttu6f1iaa8jefc6u.apps.googleusercontent.com
