# Copy to supabase/.env.local (gitignored) and fill in before running `supabase start`
# with auth.external.apple / auth.external.google enabled in config.toml.

SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=


# Comma-separated: iOS client ID, then Web client ID (see apps/mobile's
# GOOGLE_IOS_CLIENT_ID / GOOGLE_WEB_CLIENT_ID for the same two values).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
